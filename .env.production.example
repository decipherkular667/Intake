# IntakeAI Health - Production Environment Configuration
# Copy this file to .env and update with your production values

# Application
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:production.sqlite

# Security (CRITICAL - Generate unique values!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secure-session-secret-min-64-chars-generated-with-crypto-randomBytes

# CORS Origins (Replace with your actual domain)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# AI Services (Optional but recommended for full functionality)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_TOKEN=your-huggingface-token

# External APIs (Optional)
USDA_API_KEY=your-usda-api-key
FOOD_API_KEY=your-food-api-key

# Email Configuration (Optional - for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
MONITORING_EMAIL=admin@yourdomain.com

# App Information
APP_NAME=IntakeAI Health
APP_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs/app.log

# Feature Flags
ENABLE_AI_INSIGHTS=true
ENABLE_TRANSLATION=true
ENABLE_FOOD_SEARCH=true
ENABLE_TCM_RECOMMENDATIONS=true
ENABLE_ANALYTICS=false