# =================================
# IntakeAI Health - Environment Configuration
# =================================

# =================================
# CORE APPLICATION SETTINGS
# =================================

# Application Environment (development, production, test)
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=localhost

# Application Name and Version
APP_NAME="IntakeAI Health"
APP_VERSION=1.0.0

# =================================
# DATABASE CONFIGURATION
# =================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database?sslmode=require
# Examples:
#   Local: postgresql://username:password@localhost:5432/intakeai_health
#   Neon: postgresql://username:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
#   Railway: postgresql://postgres:password@containers-us-west-xx.railway.app:5432/railway
DATABASE_URL=postgresql://username:password@localhost:5432/intakeai_health

# Database Pool Settings (optional)
DB_POOL_MIN=0
DB_POOL_MAX=10

# =================================
# AUTHENTICATION & SECURITY
# =================================

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here_change_this_in_production

# JWT Settings (if using JWT)
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# =================================
# AI SERVICE API KEYS
# =================================

# OpenAI API (for AI recommendations and insights)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google APIs
# Get from: https://console.developers.google.com/
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Hugging Face API (for open-source models)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# =================================
# EXTERNAL DATA SOURCES
# =================================

# USDA Food Database API (for nutrition data)
# Get from: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here

# Generic Food API Key (fallback)
FOOD_API_KEY=your_food_api_key_here

# =================================
# LOGGING & MONITORING
# =================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log to File (true/false)
LOG_TO_FILE=true

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# =================================
# EMAIL CONFIGURATION (optional)
# =================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@intakeai.health

# =================================
# RATE LIMITING & PERFORMANCE
# =================================

# Rate Limiting (requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Settings
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# =================================
# DEVELOPMENT SETTINGS
# =================================

# Enable Debug Mode (development only)
DEBUG=true

# Enable API Documentation
ENABLE_DOCS=true

# Seed Database on Start (development only)
AUTO_SEED_DB=false

# =================================
# PRODUCTION SETTINGS
# =================================

# SSL/HTTPS (production only)
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Cluster Mode (production only)
CLUSTER_MODE=false
WORKERS=4

# =================================
# FEATURE FLAGS
# =================================

# Enable specific features
ENABLE_AI_INSIGHTS=true
ENABLE_TRANSLATION=true
ENABLE_FOOD_SEARCH=true
ENABLE_TCM_RECOMMENDATIONS=true
ENABLE_ANALYTICS=false

# =================================
# THIRD-PARTY INTEGRATIONS
# =================================

# Google Analytics (optional)
GA_TRACKING_ID=your_ga_tracking_id

# Mixpanel (optional)
MIXPANEL_TOKEN=your_mixpanel_token

# =================================
# BACKUP & MAINTENANCE
# =================================

# Database Backup Settings
BACKUP_S3_BUCKET=your_backup_bucket
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_SCHEDULE="0 2 * * *"

# =================================
# NOTES
# =================================

# 1. Never commit this file with real values
# 2. Copy to .env and fill in real values
# 3. Use different values for different environments
# 4. Keep secrets secure and rotate them regularly
# 5. Required variables: DATABASE_URL, SESSION_SECRET
# 6. AI features require at least one AI API key